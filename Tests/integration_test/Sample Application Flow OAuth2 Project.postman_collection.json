	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"requests": {},
				"exec": [
					"// Pre-request script for Sample Application Flow OAuth2 Project Collection",
					"",
					"// Helper function to validate ISBN format (ISBN-10 or ISBN-13)",
					"pm.collectionVariables.set(\"validateISBN\", function(isbn) {",
					"    if (!isbn) return false;",
					"    ",
					"    // Remove hyphens and spaces",
					"    const cleanISBN = isbn.replace(/[-\\s]/g, '');",
					"    ",
					"    // Check if it's ISBN-10 or ISBN-13",
					"    if (cleanISBN.length === 10 || cleanISBN.length === 13) {",
					"        return /^[0-9X]+$/.test(cleanISBN);",
					"    }",
					"    return false;",
					"});",
					"",
					"// Log request information for debugging",
					"console.log(`[Pre-Request] ${pm.info.requestName}`);",
					"console.log(`[Pre-Request] Method: ${pm.request.method}`);",
					"console.log(`[Pre-Request] URL: ${pm.request.url.toString()}`);",
					"",
					"// Set timestamp for request tracking",
					"pm.collectionVariables.set(\"requestTimestamp\", new Date().toISOString());",
					"",
					"// Validate ISBN in path variables if present",
					"if (pm.request.url.path && pm.request.url.path.includes(':isbn')) {",
					"    const pathVariables = pm.request.url.variable;",
					"    if (pathVariables) {",
					"        pathVariables.forEach(variable => {",
					"            if (variable.key === 'isbn' && variable.value) {",
					"                console.log(`[Pre-Request] ISBN in path: ${variable.value}`);",
					"            }",
					"        });",
					"    }",
					"}",
					"",
					"// Validate copy_id in path variables if present",
					"if (pm.request.url.path && pm.request.url.path.includes(':copy_id')) {",
					"    const pathVariables = pm.request.url.variable;",
					"    if (pathVariables) {",
					"        pathVariables.forEach(variable => {",
					"            if (variable.key === 'copy_id' && variable.value) {",
					"                console.log(`[Pre-Request] Copy ID in path: ${variable.value}`);",
					"            }",
					"        });",
					"    }",
					"}",
					"",
					"// Log pagination parameters for list requests",
					"if (pm.request.url.query && pm.request.url.query.count() > 0) {",
					"    console.log('[Pre-Request] Query Parameters:');",
					"    pm.request.url.query.each(param => {",
					"        console.log(`  ${param.key}: ${param.value}`);",
					"    });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"requests": {},
				"exec": [
					"const reqName = pm.info.requestName;",
					"const method = pm.request.method;",
					"const code = pm.response.code;",
					"const time = pm.response.responseTime;",
					"",
					"console.log(`[Test] ${reqName} → ${code} (${time}ms)`);",
					"",
					"",
					"// response check -> ping to server and check test for response",
					"pm.test(\"Response exists\", () => {",
					"    pm.expect(pm.response).to.not.be.undefined;",
					"});",
					"",
					"pm.test(\"Response time < 2000ms\", () => {",
					"    pm.expect(time).to.be.below(2000);",
					"});",
					"",
					"",
					"// Status code validation -> check if server only return allowed response codes",
					"pm.test(\"Valid status code\", () => {",
					"    const validCodes = [200, 201, 204, 400, 401, 404, 422, 500];",
					"    pm.expect(validCodes).to.include(code);",
					"});",
					"",
					"// Method-specific quick checks",
					"if (method === \"GET\") {",
					"    pm.test(\"GET → 200 or 404\", () => pm.expect(code).to.be.oneOf([200, 404]));",
					"} else if (method === \"POST\") {",
					"    pm.test(\"POST → 201 or error\", () => pm.expect(code).to.be.oneOf([201, 400, 409, 422]));",
					"} else if (method === \"PUT\") {",
					"    pm.test(\"PUT → 200 or 404\", () => pm.expect(code).to.be.oneOf([200, 404, 422]));",
					"} else if (method === \"DELETE\") {",
					"    pm.test(\"DELETE → 200 or 204\", () => pm.expect(code).to.be.oneOf([200, 204, 404]));",
					"}",
					"",
					"// check if server response with correct format",
					"if (code !== 204) {",
					"    pm.test(\"Has Content-Type header\", () => {",
					"        pm.response.to.have.header(\"Content-Type\");",
					"    });",
					"}",
					"",
					"let data = {};",
					"try { data = pm.response.json(); } catch (e) {}",
					"",
					"if (code >= 200 && code < 300 && data) {",
					"    pm.test(\"Response is valid JSON object or array\", () => {",
					"        pm.expect(data).to.satisfy(d => Array.isArray(d) || typeof d === \"object\");",
					"    });",
					"",
					"    // Example for /books endpoints",
					"    if (reqName.toLowerCase().includes(\"book\")) {",
					"        pm.test(\"Contains 'isbn' field if applicable\", () => {",
					"            const item = Array.isArray(data) ? data[0] : data;",
					"            if (item) pm.expect(item).to.have.property(\"isbn\");",
					"        });",
					"    }",
					"}",
					"",
					"// test error response",
					"if (code >= 400) {",
					"    pm.test(\"Error response has body\", () => {",
					"        pm.expect(pm.response.text()).to.not.be.empty;",
					"    });",
					"",
					"    try {",
					"        const err = pm.response.json();",
					"        pm.test(\"Error has details\", () => {",
					"            pm.expect(err.error || err.message || err.detail).to.exist;",
					"        });",
					"    } catch (e) {",
					"        console.log(\"Non-JSON error body\");",
					"    }",
					"}",
					"",
					"console.log(`[Summary] ${reqName}: ${code} in ${time}ms`);",
					""
				]
			}
		}
