		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"requests": {},
				"exec": [
					"const reqName = pm.info.requestName;",
					"const method = pm.request.method;",
					"const code = pm.response.code;",
					"const time = pm.response.responseTime;",
					"",
					"console.log(`[Test] ${reqName} → ${code} (${time}ms)`);",
					"",
					"",
					"// response check -> ping to server and check test for response",
					"pm.test(\"Response exists\", () => {",
					"    pm.expect(pm.response).to.not.be.undefined;",
					"});",
					"",
					"pm.test(\"Response time < 2000ms\", () => {",
					"    pm.expect(time).to.be.below(2000);",
					"});",
					"",
					"",
					"// Status code validation -> check if server only return allowed response codes",
					"pm.test(\"Valid status code\", () => {",
					"    const validCodes = [200, 201, 204, 400, 401, 404, 422, 500, 409];",
					"    pm.expect(validCodes).to.include(code);",
					"});",
					"",
					"// Method-specific quick checks",
					"if (method === \"GET\") {",
					"    pm.test(\"GET → 200 or 404\", () => pm.expect(code).to.be.oneOf([200, 404]));",
					"} else if (method === \"POST\") {",
					"    pm.test(\"POST → 201 or error\", () => pm.expect(code).to.be.oneOf([201, 400, 409, 422, 404]));",
					"} else if (method === \"PUT\") {",
					"    pm.test(\"PUT → 200 or 404\", () => pm.expect(code).to.be.oneOf([200, 404, 422]));",
					"} else if (method === \"DELETE\") {",
					"    pm.test(\"DELETE → 200 or 204\", () => pm.expect(code).to.be.oneOf([200, 204, 404]));",
					"}",
					"",
					"",
					"let data = {};",
					"try { data = pm.response.json(); } catch (e) {}",
					"",
					"if (code >= 200 && code < 300 && data) {",
					"    pm.test(\"Response is valid JSON object or array\", () => {",
					"        pm.expect(data).to.satisfy(d => Array.isArray(d) || typeof d === \"object\");",
					"    });",
					"",
					"    // Example for /books endpoints",
					"    if (reqName.toLowerCase().includes(\"book\")) {",
					"        pm.test(\"Contains 'isbn' field if applicable\", () => {",
					"            let item;",
					"            ",
					"            // paginated response with array",
					"            if (data.items && Array.isArray(data.items)) {",
					"                item = data.items[0];",
					"            } ",
					"            // direct array response",
					"            else if (Array.isArray(data)) {",
					"                item = data[0];",
					"            } ",
					"            // single object response",
					"            else {",
					"                item = data;",
					"            }",
					"            ",
					"            // single item",
					"            if (item) {",
					"                pm.expect(item).to.have.property(\"isbn\");",
					"            }",
					"        });",
					"    }",
					"}",
					"",
					"// test error response",
					"if (code >= 400) {",
					"    pm.test(\"Error response has body\", () => {",
					"        pm.expect(pm.response.text()).to.not.be.empty;",
					"    });",
					"",
					"    try {",
					"        const err = pm.response.json();",
					"        pm.test(\"Error has details\", () => {",
					"            pm.expect(err).to.satisfy(e => e.message || e.error || e.detail);",
					"        });",
					"    } catch (e) {}",
					"}"
				]
			}
		}
